# Use a nonempty gateway key. For a random token: openssl rand -hex 32
BRIDGE_TOKEN=replace-with-your-gateway-key
# Set this to the gateway's intranet IP to accept requests from your other machine.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8765
CODEX_BIN=codex
# Optional: use the Codex default unless you select a model from GET /v1/models.
# BRIDGE_MODEL=
# Optional service default; an explicit client reasoning effort takes precedence.
# BRIDGE_REASONING_EFFORT=low
# CODEX_HOME=/home/your-user/.codex
BRIDGE_TIMEOUT_MS=180000
BRIDGE_MAX_CONCURRENT=2
BRIDGE_MAX_BODY_BYTES=1048576
# Waiting tool turns count toward the session cap; client results expire after 5 minutes.
BRIDGE_MAX_SESSIONS=8
BRIDGE_TOOL_TIMEOUT_MS=300000
